{
  "name": "@et/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/index.ts",
    "build": "pnpm --filter @et/shared build && tsc -p tsconfig.build.json",
    "start": "node --conditions=et-dist --disable-warning=ExperimentalWarning dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@et/shared": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
