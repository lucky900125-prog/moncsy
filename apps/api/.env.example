# --- Server ---
PORT=8787
# Any address other than localhost needs API_TOKEN (or ALLOW_NO_AUTH=1); the server refuses to start otherwise.
HOST=127.0.0.1
DB_PATH=./data/expense.db
# Comma-separated allowed origins, or * for any. Without API_TOKEN, "*" lets any website read your data.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# --- Access ---
# When set, every /api route except /health needs "Authorization: Bearer <API_TOKEN>".
# Generate one with: openssl rand -base64 32   (or put it in a file and set API_TOKEN_FILE instead)
API_TOKEN=
# Run without a token on a non-localhost HOST, e.g. a trusted home network. Logged as a warning.
ALLOW_NO_AUTH=
# Reverse proxies in front of the API whose X-Forwarded-For may be trusted (0 = use the socket address).
TRUST_PROXY_HOPS=0

# --- Off-site backup (for hosts whose disk is wiped on restart, like Render's free plan) ---
# All three or none. The SQLite file is gzipped, encrypted with AES-256-GCM using BACKUP_KEY, and committed
# to BACKUP_GITHUB_PATH in a PRIVATE repository; on start, a missing database is restored from it.
BACKUP_GITHUB_REPO=
# Fine-grained token with Contents: Read and write on that one repository only (or BACKUP_GITHUB_TOKEN_FILE)
BACKUP_GITHUB_TOKEN=
# 32 random bytes in base64: openssl rand -base64 32. Keep a copy in your password manager; without it
# the backup cannot be decrypted. (or BACKUP_KEY_FILE)
BACKUP_KEY=
BACKUP_GITHUB_PATH=moncsy.db.enc
# Upload this many ms after the last write (default 10000)
BACKUP_DEBOUNCE_MS=
# 1 = refuse to start when the three BACKUP_ values above are missing
REQUIRE_BACKUP=
# 1 = start although the backup file was deleted or rolled back (its history shows a newer copy); one start only
BACKUP_ALLOW_RESET=
# Fallback currency for /summary and /ai/analyze when the range has no transactions, and for statements without one
DEFAULT_CURRENCY=HUF
# Time zone of the wall-clock times written in bank statements
STATEMENT_TZ=Europe/Budapest

# --- AI provider: anthropic | openai | ollama | mock ---
# Unset: anthropic if ANTHROPIC_API_KEY is set, else openai if OPENAI_API_KEY is set, else mock.
AI_PROVIDER=mock
# Model id; defaults: anthropic=claude-sonnet-5-5, openai=gpt-4.1-mini, ollama=llama3.2-vision
AI_MODEL=
# Key for the selected provider (overrides ANTHROPIC_API_KEY / OPENAI_API_KEY)
AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Override the provider endpoint. Examples:
#   OpenRouter: https://openrouter.ai/api/v1   Groq: https://api.groq.com/openai/v1
#   LM Studio:  http://localhost:1234/v1       Ollama: http://localhost:11434
AI_BASE_URL=
# Request timeout in ms (default 90000; ollama 180000)
AI_TIMEOUT_MS=
# openai provider: set to "off" if the server rejects response_format=json_object
AI_JSON_MODE=on
# anthropic provider: server-side refusal fallback (fallbacks: "default"); "off" to disable
ANTHROPIC_FALLBACKS=on
# AI calls allowed per UTC day (receipt scans, analyses, PDF statements); 0 turns the AI off.
AI_DAILY_LIMIT=100

# --- Revolut: business-api | open-banking | csv ---
# Unset: business-api if REVOLUT_BUSINESS_TOKEN is set, else csv.
REVOLUT_MODE=csv
# Revolut Business API access token (expires after 40 minutes)
REVOLUT_BUSINESS_TOKEN=
# production | sandbox
REVOLUT_ENV=production
