# Local settings for `pnpm dev:api`. Copy this file to .env here, in the repository root, and fill it in;
# .env is never committed (.gitignore). Every setting the API knows is listed in apps/api/.env.example.
# A setting in apps/api/.env as well with another value stops the API at start; a real environment variable wins over both.

# AI for receipt scanning and analysis: anthropic | openai | ollama | mock (mock answers with sample data, no key)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# For AI_PROVIDER=openai instead:
# OPENAI_API_KEY=
# Model id; empty = the provider's default (see apps/api/.env.example)
AI_MODEL=

# Optional. Relative paths are relative to apps/api, where `pnpm dev:api` runs.
# DB_PATH=./data/expense.db
# DEFAULT_CURRENCY=HUF
# STATEMENT_TZ=Europe/Budapest
