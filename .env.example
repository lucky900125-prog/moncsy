# Local settings for `pnpm dev:api`. Copy this file to .env here, in the repository root, and fill it in;
# .env is never committed (.gitignore). Every setting the API knows is listed in apps/api/.env.example.
# A setting in apps/api/.env as well with another value stops the API at start; a real environment variable wins over both.

# AI for receipt scanning and analysis. Every provider with a key here can be chosen in the app's settings, with its
# models; AI_PROVIDER and AI_MODEL are only the default. anthropic | openai | gemini | ollama | mock
# (mock answers with sample data and needs no key, and then no key may be set).
AI_PROVIDER=anthropic
# Model id; empty = the default provider's first model (claude-sonnet-5-5, gpt-6-luna, gemini-3.5-flash-lite)
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Google AI Studio key; Gemini is called on its OpenAI-compatible endpoint
GEMINI_API_KEY=

# Optional. Relative paths are relative to apps/api, where `pnpm dev:api` runs.
# DB_PATH=./data/expense.db
# DEFAULT_CURRENCY=HUF
# STATEMENT_TZ=Europe/Budapest
